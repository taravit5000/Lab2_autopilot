Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 10
    Color: 160; 160; 164
    Alpha: 0.3
  - Class: rviz_default_plugins/Map
    Name: Map
    Enabled: true
    Alpha: 1
    Color Scheme: map
    Draw Behind: false
    Topic:
      Value: /map
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
    Use Timestamp: false
  - Class: rviz_default_plugins/LaserScan
    Name: LaserScan
    Enabled: true
    Topic:
      Value: /scan
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Best Effort
    Size (m): 0.03
    Style: Points
    Color Transformer: FlatColor
    Color: 0; 255; 0
    Position Transformer: XYZ
    Decay Time: 0
    Alpha: 1.0
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Show Arrows: true
    Show Axes: true
    Show Names: true
    Marker Scale: 1
    Frames:
      All Enabled: true
      map:
        Value: true
      odom:
        Value: true
      base_footprint:
        Value: true
      base_link:
        Value: true
      base_scan:
        Value: true
      caster_back_link:
        Value: true
      imu_link:
        Value: true
      wheel_left_link:
        Value: true
      wheel_right_link:
        Value: true
    Frame Timeout: 15
    Update Interval: 0
    Value: true
  Global Options:
    Background Color: 150; 150; 150
    Fixed Frame: map
    Frame Rate: 15
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 70
      Angle: 0
      X: 0
      Y: 0
      Near Clip Distance: 0.01
      Target Frame: map
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
  - Class: rviz_default_plugins/SetInitialPose
  - Class: rviz_default_plugins/SetGoal
  - Class: rviz_default_plugins/PublishPoint
Window Geometry:
  Width: 960
  Height: 850
  X: 960
  Y: 35
